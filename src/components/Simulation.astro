---
// Simulation.astro — interactive physics/math simulation with canvas.
// Type determines which simulation to run. Params are adjustable by reader.
//
// IMPORTANT: Astro does not interpolate `{...}` inside <script> blocks or
// string attributes, so everything is wired through data attributes.

interface Props {
  type: 'double-pendulum' | 'wave' | 'projectile' | 'custom'
  params?: Record<string, number>
  editableParams?: string[]
  width?: number
  height?: number
}

const { type, params = {}, editableParams = [], width = 600, height = 400 } = Astro.props
---

<div
  class="interactive-block"
  data-sim
  data-type={type}
  data-params={JSON.stringify(params)}
  data-editable={JSON.stringify(editableParams)}
>
  <div class="interactive-block__header">
    <span>🔬 交互式模拟 — {type}</span>
    <span style="font-size: 0.75rem; color: var(--text-muted);">
      拖拽参数观察变化
    </span>
  </div>
  <div class="interactive-block__body">
    <canvas
      data-role="canvas"
      width={width}
      height={height}
      style="
        display: block; margin: 0 auto;
        border-radius: var(--radius); background: var(--bg);
        max-width: 100%; height: auto;
      "
    ></canvas>

    {editableParams.length > 0 && (
      <div
        style="
          display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.8rem;
          padding: 0.6rem 0.8rem; background: var(--bg-card);
          border-radius: var(--radius);
        "
      >
        {editableParams.map(name => (
          <label style="font-size: 0.8rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.4rem;">
            {name}
            <input
              type="range"
              data-param={name}
              min="0.1"
              max={params[name] ? params[name] * 3 : 10}
              step="0.1"
              value={params[name] ?? 1}
              style="width: 80px;"
            />
            <span
              data-param-value={name}
              style="color: var(--accent); font-family: var(--font-mono); min-width: 3em;"
            >{params[name] ?? 1}</span>
          </label>
        ))}
      </div>
    )}
  </div>
</div>

<script>
  document.querySelectorAll('[data-sim]').forEach(root => {
    const canvas = root.querySelector('[data-role="canvas"]') as HTMLCanvasElement | null
    if (!canvas) return
    const ctx = canvas.getContext('2d')
    if (!ctx) return

    const type = root.getAttribute('data-type') || 'custom'
    let simParams: Record<string, number> = {}
    let editable: string[] = []
    try {
      simParams = JSON.parse(root.getAttribute('data-params') || '{}')
      editable = JSON.parse(root.getAttribute('data-editable') || '[]')
    } catch {}

    for (const name of editable) {
      const input = root.querySelector(`[data-param="${name}"]`) as HTMLInputElement | null
      const label = root.querySelector(`[data-param-value="${name}"]`) as HTMLElement | null
      if (!input) continue
      input.addEventListener('input', () => {
        simParams[name] = parseFloat(input.value)
        if (label) label.textContent = input.value
      })
    }

    // Placeholder visualization. Real simulations (ODE integration for the
    // pendulum, wave equation, projectile motion) plug in here per `type`.
    function draw(t: number) {
      const w = canvas!.width
      const h = canvas!.height
      ctx!.fillStyle = '#0d1117'
      ctx!.fillRect(0, 0, w, h)

      ctx!.fillStyle = '#8b949e'
      ctx!.font = '14px monospace'
      ctx!.textAlign = 'center'
      ctx!.fillText(`Simulation: ${type} (frame ${Math.floor(t * 60)})`, w / 2, h / 2 - 10)
      ctx!.fillText('Implement specific simulation logic for this type.', w / 2, h / 2 + 15)
    }

    let animId = 0
    let start = 0

    const observer = new IntersectionObserver(
      entries => {
        if (entries[0].isIntersecting) {
          start = performance.now()
          const loop = (now: number) => {
            draw((now - start) / 1000)
            animId = requestAnimationFrame(loop)
          }
          animId = requestAnimationFrame(loop)
        } else {
          cancelAnimationFrame(animId)
        }
      },
      { rootMargin: '200px' }
    )
    observer.observe(canvas)
  })
</script>
