---
// Simulation.astro — interactive physics/math simulation with canvas.
// Type determines which simulation to run. Params are adjustable by reader.

interface Props {
  type: 'double-pendulum' | 'wave' | 'projectile' | 'custom'
  params?: Record<string, number>
  editableParams?: string[]
  width?: number
  height?: number
}

const {
  type,
  params = {},
  editableParams = [],
  width = 600,
  height = 400,
} = Astro.props
const id = `sim-${Math.random().toString(36).slice(2, 8)}`
---

<div class="interactive-block" id={id}>
  <div class="interactive-block__header">
    <span>🔬 交互式模拟 — {type}</span>
    <span style="font-size: 0.75rem; color: var(--text-muted);">
      拖拽参数观察变化
    </span>
  </div>
  <div class="interactive-block__body">
    <canvas
      id="{id}-canvas"
      width={width}
      height={height}
      style="
        display: block; margin: 0 auto;
        border-radius: var(--radius); background: var(--bg);
        max-width: 100%; height: auto;
      "
    ></canvas>

    {editableParams.length > 0 && (
      <div
        id="{id}-controls"
        style="
          display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.8rem;
          padding: 0.6rem 0.8rem; background: var(--bg-card);
          border-radius: var(--radius);
        "
      >
        {editableParams.map(name => (
          <label style="font-size: 0.8rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.4rem;">
            {name}
            <input
              type="range"
              id="{id}-param-{name}"
              min="0.1"
              max={params[name] ? params[name] * 3 : 10}
              step="0.1"
              value={params[name] ?? 1}
              style="width: 80px;"
            />
            <span
              id="{id}-param-{name}-val"
              style="color: var(--accent); font-family: var(--font-mono); min-width: 3em;"
            >{params[name] ?? 1}</span>
          </label>
        ))}
      </div>
    )}
  </div>
</div>

<script>
  (function() {
    const canvas = document.getElementById('{id}-canvas') as HTMLCanvasElement | null
    if (!canvas) return

    const ctx = canvas.getContext('2d')
    if (!ctx) return

    const simParams = { ...JSON.parse('{JSON.stringify(params)}') }
    const editable = JSON.parse('{JSON.stringify(editableParams)}') as string[]

    // Bind range inputs
    for (const name of editable) {
      const input = document.getElementById('{id}-param-' + name) as HTMLInputElement | null
      const label = document.getElementById('{id}-param-' + name + '-val')
      if (input) {
        input.addEventListener('input', () => {
          simParams[name] = parseFloat(input.value)
          if (label) label.textContent = input.value
        })
      }
    }

    // Placeholder: draw a simple visualization based on type.
    // In production, each `type` maps to a full simulation class
    // (ODE integration for pendulum, wave equation, etc.)
    function draw(t: number) {
      const w = canvas!.width, h = canvas!.height
      ctx!.fillStyle = 'var(--bg, #0d1117)'
      ctx!.fillRect(0, 0, w, h)

      ctx!.fillStyle = '#8b949e'
      ctx!.font = '14px monospace'
      ctx!.textAlign = 'center'
      ctx!.fillText(
        `Simulation: {type} (frame ${Math.floor(t / 60)})`,
        w / 2,
        h / 2 - 10
      )
      ctx!.fillText(
        'Implement specific simulation logic for this type.',
        w / 2,
        h / 2 + 15
      )
    }

    // Render loop — only when visible
    let animId = 0
    let start = 0

    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        start = performance.now()
        function loop(now: number) {
          draw((now - start) / 1000)
          animId = requestAnimationFrame(loop)
        }
        animId = requestAnimationFrame(loop)
      } else {
        cancelAnimationFrame(animId)
      }
    }, { rootMargin: '200px' })
    observer.observe(canvas)
  })()
</script>
