---
// WasmDemo.astro — loads a wasm-pack module and renders to canvas.
// Uses IntersectionObserver for lazy loading, with a pure-JS fallback.
//
// IMPORTANT: Astro does not interpolate `{...}` inside <script> blocks or
// string attributes, so everything is wired through data attributes.

interface Props {
  wasm: string       // path to .wasm file (display only)
  js: string         // path to JS glue code (wasm-pack output)
  width?: number
  height?: number
  caption?: string
}

const { wasm, js, width = 640, height = 400, caption } = Astro.props
---

<div class="interactive-block" data-wasm data-wasm-js={js} data-wasm-file={wasm}>
  <div class="interactive-block__header">
    <span>🦀 WASM Demo</span>
    <span data-role="subtitle" style="font-size: 0.75rem; color: var(--text-muted);">
      {wasm.split('/').pop()}
    </span>
  </div>
  <div class="interactive-block__body" style="text-align: center;">
    <canvas
      data-role="canvas"
      width={width}
      height={height}
      style="
        border-radius: var(--radius);
        background: #000;
        max-width: 100%;
        height: auto;
        cursor: crosshair;
      "
    ></canvas>
    {caption && (
      <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.4rem;">
        {caption}
      </p>
    )}
    <p
      data-role="status"
      style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.5rem;"
    >加载 WASM 模块中...</p>
    <div style="margin-top: 0.4rem; font-size: 0.75rem; color: var(--text-muted);">
      💡 点击画布放大，右键缩小
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-wasm]').forEach(root => {
    const canvas = root.querySelector('[data-role="canvas"]') as HTMLCanvasElement | null
    const status = root.querySelector('[data-role="status"]') as HTMLElement | null
    if (!canvas || !status) return

    const wasmJsPath = root.getAttribute('data-wasm-js') || ''
    const ctx = canvas.getContext('2d')
    if (!ctx) return

    let wasmModule: any = null
    let useWasm = false
    let wasmTried = false
    let centerX = -0.5
    let centerY = 0.0
    let zoom = 1.0
    const maxIter = 200

    // ── JS fallback Mandelbrot renderer ─────────────────────

    function mandelbrotJS(cx: number, cy: number): number {
      let x = 0
      let y = 0
      let iter = 0
      while (x * x + y * y <= 4 && iter < maxIter) {
        const xt = x * x - y * y + cx
        y = 2 * x * y + cy
        x = xt
        iter++
      }
      return iter
    }

    function hsvToRgb(h: number, s: number, v: number): [number, number, number] {
      const c = v * s
      const hp = h / 60
      const x = c * (1 - Math.abs((hp % 2) - 1))
      let r1 = 0
      let g1 = 0
      let b1 = 0
      const seg = Math.floor(hp) % 6
      if (seg === 0) { r1 = c; g1 = x }
      else if (seg === 1) { r1 = x; g1 = c }
      else if (seg === 2) { g1 = c; b1 = x }
      else if (seg === 3) { g1 = x; b1 = c }
      else if (seg === 4) { r1 = x; b1 = c }
      else { r1 = c; b1 = x }
      const m = v - c
      return [(r1 + m) * 255, (g1 + m) * 255, (b1 + m) * 255]
    }

    function renderJS() {
      const w = canvas!.width
      const h = canvas!.height
      const imgData = ctx!.createImageData(w, h)
      const aspect = w / h
      const scale = 4.0 / zoom
      const xMin = centerX - (scale * aspect) / 2
      const yMin = centerY - scale / 2
      const dx = (scale * aspect) / w
      const dy = scale / h

      for (let py = 0; py < h; py++) {
        const cy = yMin + py * dy
        for (let px = 0; px < w; px++) {
          const cx = xMin + px * dx
          const iter = mandelbrotJS(cx, cy)
          const idx = (py * w + px) * 4
          if (iter === maxIter) {
            imgData.data[idx] = 0
            imgData.data[idx + 1] = 0
            imgData.data[idx + 2] = 0
            imgData.data[idx + 3] = 255
          } else {
            const t = iter / maxIter
            const hue = (t * 360 + 200) % 360
            const [r, g, b] = hsvToRgb(hue, 0.8, 0.9)
            imgData.data[idx] = r
            imgData.data[idx + 1] = g
            imgData.data[idx + 2] = b
            imgData.data[idx + 3] = 255
          }
        }
      }
      ctx!.putImageData(imgData, 0, 0)
    }

    // ── WASM render ─────────────────────────────────────────

    function renderWasm() {
      const data = wasmModule.render(canvas!.width, canvas!.height, centerX, centerY, zoom, maxIter)
      const imgData = ctx!.createImageData(canvas!.width, canvas!.height)
      imgData.data.set(new Uint8Array(data))
      ctx!.putImageData(imgData, 0, 0)
    }

    async function render() {
      status!.textContent = '渲染中...'
      const start = performance.now()
      try {
        if (useWasm && wasmModule) {
          renderWasm()
        } else {
          renderJS()
        }
        const elapsed = (performance.now() - start).toFixed(0)
        const mode = useWasm ? 'WASM' : wasmTried ? 'JS（WASM 回退）' : 'JS'
        status!.textContent = `✅ ${mode} | 中心: (${centerX.toFixed(4)}, ${centerY.toFixed(4)}) | 缩放: ${zoom.toFixed(1)}x | ${elapsed}ms`
        status!.style.color = 'var(--success)'
      } catch (err: any) {
        status!.textContent = '❌ 渲染失败: ' + (err?.message || err)
        status!.style.color = 'var(--danger)'
      }
    }

    async function init() {
      // 1. Render immediately with JS (always works)
      useWasm = false
      status!.textContent = '🟨 JS 渲染中...'
      status!.style.color = 'var(--warning)'
      await render()

      // 2. Try WASM in the background (glue file may not exist)
      if (!wasmJsPath) return
      wasmTried = true
      try {
        const jsUrl = new URL(wasmJsPath, document.baseURI).href
        // Avoid a noisy module-import 404 when the glue hasn't been built.
        const head = await fetch(jsUrl, { method: 'HEAD' }).catch(() => null)
        if (!head || !head.ok) return
        const importPromise = import(/* @vite-ignore */ jsUrl)
        const timeout = new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 4000))
        const mod: any = await Promise.race([importPromise, timeout])
        await mod.default?.()
        if (typeof mod.render !== 'function') throw new Error('missing render()')
        wasmModule = mod
        useWasm = true
        await render()
      } catch {
        // WASM unavailable — JS stays active
      }
    }

    canvas.addEventListener('click', e => {
      const rect = canvas!.getBoundingClientRect()
      const x = (e.clientX - rect.left) / rect.width
      const y = (e.clientY - rect.top) / rect.height
      const scale = 4.0 / zoom
      const aspect = canvas!.width / canvas!.height
      centerX = centerX + (x - 0.5) * scale * aspect
      centerY = centerY + (y - 0.5) * scale
      zoom *= 2.0
      render()
    })

    canvas.addEventListener('contextmenu', e => {
      e.preventDefault()
      if (zoom <= 1.0) return
      zoom /= 2.0
      render()
    })

    const observer = new IntersectionObserver(
      entries => {
        if (entries[0].isIntersecting) {
          init()
          observer.disconnect()
        }
      },
      { rootMargin: '200px' }
    )
    observer.observe(canvas)
  })
</script>
