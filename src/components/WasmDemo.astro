---
// WasmDemo.astro — loads a wasm-pack module and renders to canvas.
// Uses IntersectionObserver for lazy loading.
// The WASM module is expected to export a `render(w, h, cx, cy, zoom, max_iter) -> Vec<u8>` function.

interface Props {
  wasm: string       // path to .wasm file
  js: string         // path to JS glue code (wasm-pack output)
  canvasId?: string
  width?: number
  height?: number
  caption?: string
}

const {
  wasm,
  js,
  canvasId = `wasm-canvas-${Math.random().toString(36).slice(2, 8)}`,
  width = 640,
  height = 400,
  caption,
} = Astro.props
---

<div class="interactive-block" id={`${canvasId}-container`} data-wasm-js={js}>
  <div class="interactive-block__header">
    <span>🦀 WASM Demo</span>
    <span style="font-size: 0.75rem; color: var(--text-muted);" id={`${canvasId}-subtitle`}>
      {wasm.split('/').pop()}
    </span>
  </div>
  <div class="interactive-block__body" style="text-align: center;">
    <canvas
      id={canvasId}
      width={width}
      height={height}
      style="
        border-radius: var(--radius);
        background: #000;
        max-width: 100%;
        height: auto;
        cursor: crosshair;
      "
    ></canvas>
    {caption && (
      <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.4rem;">
        {caption}
      </p>
    )}
    <p
      id={`${canvasId}-status`}
      style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.5rem;"
    >加载 WASM 模块中...</p>
    <div style="margin-top: 0.4rem; font-size: 0.75rem; color: var(--text-muted);">
      💡 点击画布放大，右键缩小
    </div>
  </div>
</div>

<script>
  (function() {
    const container = document.getElementById('{canvasId}-container')
    const canvas = document.getElementById('{canvasId}') as HTMLCanvasElement | null
    const status = document.getElementById('{canvasId}-status')
    if (!canvas || !status || !container) return

    const wasmJsPath = container.dataset.wasmJs || ''

    let wasmModule: any = null
    let useWasm = false
    let centerX = -0.5
    let centerY = 0.0
    let zoom = 1.0
    const maxIter = 200

    // ── JS Fallback Mandelbrot renderer ─────────────────────

    function mandelbrotJS(cx: number, cy: number): number {
      let x = 0, y = 0, iter = 0
      while (x*x + y*y <= 4 && iter < maxIter) {
        const xt = x*x - y*y + cx
        y = 2*x*y + cy
        x = xt
        iter++
      }
      return iter
    }

    function hsvToRgb(h: number, s: number, v: number): [number, number, number] {
      const c = v * s
      const hp = h / 60
      const x = c * (1 - Math.abs((hp % 2) - 1))
      let r1 = 0, g1 = 0, b1 = 0
      const seg = Math.floor(hp) % 6
      if (seg === 0) { r1 = c; g1 = x }
      else if (seg === 1) { r1 = x; g1 = c }
      else if (seg === 2) { g1 = c; b1 = x }
      else if (seg === 3) { g1 = x; b1 = c }
      else if (seg === 4) { r1 = x; b1 = c }
      else { r1 = c; b1 = x }
      const m = v - c
      return [(r1 + m) * 255, (g1 + m) * 255, (b1 + m) * 255]
    }

    function renderJS() {
      const w = canvas!.width, h = canvas!.height
      const ctx = canvas!.getContext('2d')
      if (!ctx) return
      const imgData = ctx.createImageData(w, h)
      const aspect = w / h
      const scale = 4.0 / zoom
      const xMin = centerX - scale * aspect / 2
      const yMin = centerY - scale / 2
      const dx = scale * aspect / w
      const dy = scale / h

      for (let py = 0; py < h; py++) {
        const cy = yMin + py * dy
        for (let px = 0; px < w; px++) {
          const cx = xMin + px * dx
          const iter = mandelbrotJS(cx, cy)
          const idx = (py * w + px) * 4
          if (iter === maxIter) {
            imgData.data[idx] = 0; imgData.data[idx+1] = 0
            imgData.data[idx+2] = 0; imgData.data[idx+3] = 255
          } else {
            const t = iter / maxIter
            const hue = (t * 360 + 200) % 360
            const [r, g, b] = hsvToRgb(hue, 0.8, 0.9)
            imgData.data[idx] = r; imgData.data[idx+1] = g
            imgData.data[idx+2] = b; imgData.data[idx+3] = 255
          }
        }
      }
      ctx.putImageData(imgData, 0, 0)
    }

    // ── WASM render ─────────────────────────────────────────

    function renderWasm() {
      if (!wasmModule) return
      const data = wasmModule.render(
        canvas!.width, canvas!.height,
        centerX, centerY, zoom, maxIter
      )
      const ctx = canvas!.getContext('2d')
      if (!ctx) return
      const imgData = ctx.createImageData(canvas!.width, canvas!.height)
      imgData.data.set(new Uint8Array(data))
      ctx.putImageData(imgData, 0, 0)
    }

    async function render() {
      status!.textContent = '渲染中...'
      const start = performance.now()
      try {
        if (useWasm && wasmModule) {
          renderWasm()
        } else {
          renderJS()
        }
        const elapsed = (performance.now() - start).toFixed(0)
        const mode = useWasm ? 'WASM' : 'JS'
        status!.textContent = `✅ ${mode} | 中心: (${centerX.toFixed(4)}, ${centerY.toFixed(4)}) | 缩放: ${zoom.toFixed(1)}x | ${elapsed}ms`
        status!.style.color = 'var(--success)'
      } catch (err: any) {
        status!.textContent = '❌ 渲染失败: ' + (err?.message || err)
        status!.style.color = 'var(--danger)'
      }
    }

    async function init() {
      // 1. Render immediately with JS (always works, ~200ms)
      useWasm = false
      status!.textContent = '🟨 JS 渲染中...'
      status!.style.color = 'var(--warning)'
      await render()

      // 2. Try WASM in background for future zooms
      try {
        const importPromise = import(/* @vite-ignore */ wasmJsPath)
        const timeout = new Promise((_, reject) =>
          setTimeout(() => reject(new Error('timeout')), 4000)
        )
        wasmModule = await Promise.race([importPromise, timeout])
        await wasmModule.default?.()
        useWasm = true
        // Re-render with WASM for comparison
        await render()
      } catch {
        // WASM unavailable — JS stays active, nothing changes
      }
    }

    // Click to zoom in, right-click to zoom out
    canvas.addEventListener('click', (e) => {
      const rect = canvas!.getBoundingClientRect()
      const x = (e.clientX - rect.left) / rect.width
      const y = (e.clientY - rect.top) / rect.height
      const scale = 4.0 / zoom
      const aspect = canvas!.width / canvas!.height
      centerX = centerX + (x - 0.5) * scale * aspect
      centerY = centerY + (y - 0.5) * scale
      zoom *= 2.0
      render()
    })

    canvas.addEventListener('contextmenu', (e) => {
      e.preventDefault()
      if (!wasmModule || zoom <= 1.0) return
      zoom /= 2.0
      render()
    })

    // Lazy load: only initialize when visible
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        init()
        observer.disconnect()
      }
    }, { rootMargin: '200px' })
    observer.observe(canvas)
  })()
</script>
