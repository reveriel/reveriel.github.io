---
// ShaderPlayground.astro — live WGSL shader editor with WebGPU rendering.
// Reader edits the WGSL code, clicks "Run" to compile and see the result.
//
// IMPORTANT: Astro does not interpolate `{...}` inside <script> blocks or
// string attributes, so everything is wired through data attributes.

interface Props {
  editable?: boolean
  width?: number
  height?: number
}

const { editable = true, width = 640, height = 360 } = Astro.props

const defaultShader = `// 你的第一个 shader —— 每个像素执行一次
// 点击下方 "▶ 运行" 按钮查看效果
// 试着改颜色值，再点一次运行

@fragment
fn main(@builtin(position) coord: vec4f) -> @location(0) vec4f {
  let uv = coord.xy / vec2f(${width}.0, ${height}.0);
  return vec4f(uv.x, uv.y, 0.5, 1.0);
}`
---

<div class="interactive-block" data-shader data-default-shader={defaultShader}>
  <div class="interactive-block__header">
    <span>{editable ? '✏️ Shader Playground' : '🎨 Shader 演示'}</span>
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <span data-role="gpu-badge" style="font-size: 0.75rem; color: var(--text-muted);"></span>
      {editable && (
        <button data-role="run" style="
          font-size: 0.75rem; background: var(--accent-dim); color: #fff;
          border: none; border-radius: 4px; padding: 0.25em 0.8em; cursor: pointer;
        ">▶ 运行</button>
      )}
      <a class="component-source" href="https://github.com/reveriel/reveriel.github.io/blob/master/src/components/ShaderPlayground.astro" target="_blank" rel="noopener" title="查看 ShaderPlayground 组件源码">源码 ↗</a>
    </div>
  </div>
  <div class="interactive-block__body">
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <canvas
        data-role="canvas"
        width={width}
        height={height}
        style="
          border-radius: var(--radius); background: #000;
          max-width: 100%; height: auto; display: block;
        "
      ></canvas>
      {editable && (
        <textarea
          data-role="editor"
          spellcheck="false"
          style="
            flex: 1; min-width: 280px; min-height: 240px;
            font-family: var(--font-mono); font-size: 0.78rem;
            background: var(--bg); color: var(--text);
            border: 1px solid var(--border); border-radius: var(--radius);
            padding: 0.8rem; resize: vertical; line-height: 1.5; tab-size: 2;
            outline: none;
          "
        >{defaultShader}</textarea>
      )}
    </div>
    <pre
      data-role="error"
      style="
        margin-top: 0.5rem; padding: 0.5rem 0.8rem; font-family: var(--font-mono);
        font-size: 0.78rem; color: var(--danger); white-space: pre-wrap;
        background: var(--bg); border: 1px solid var(--border);
        border-radius: 4px; display: none;
      "
    ></pre>
  </div>
</div>

<script>
  document.querySelectorAll('[data-shader]').forEach(root => {
    const canvas = root.querySelector('[data-role="canvas"]') as HTMLCanvasElement | null
    const editor = root.querySelector('[data-role="editor"]') as HTMLTextAreaElement | null
    const runBtn = root.querySelector('[data-role="run"]') as HTMLButtonElement | null
    const errorEl = root.querySelector('[data-role="error"]') as HTMLElement | null
    const gpuBadge = root.querySelector('[data-role="gpu-badge"]') as HTMLElement | null
    if (!canvas) return

    const defaultShader = root.getAttribute('data-default-shader') || ''
    let device: any = null
    let active = false

    const FULLSCREEN_QUAD_VERTEX = `
@vertex
fn vs_main(@builtin(vertex_index) idx: u32) -> @builtin(position) vec4f {
  var pos = array<vec2f, 3>(
    vec2f(-1.0,  3.0),
    vec2f(-1.0, -1.0),
    vec2f( 3.0, -1.0),
  );
  return vec4f(pos[idx], 0.0, 1.0);
}`

    function showError(msg: string, color = 'var(--danger)') {
      if (!errorEl) return
      errorEl.textContent = msg
      errorEl.style.display = 'block'
      errorEl.style.color = color
    }

    async function initGPU(): Promise<boolean> {
      if (device) return true
      const gpu = (navigator as any).gpu
      if (!gpu) {
        showFallback('WebGPU 不可用 — 请使用 Chrome 113+ / Edge 113+')
        return false
      }
      try {
        const adapter = await gpu.requestAdapter()
        if (!adapter) {
          showFallback('无法获取 GPU 适配器')
          return false
        }
        device = await adapter.requestDevice()
        if (gpuBadge) {
          gpuBadge.textContent = 'WebGPU ✅'
          gpuBadge.style.color = 'var(--success)'
        }
        return true
      } catch (err: any) {
        showFallback('GPU 初始化失败: ' + (err?.message || err))
        return false
      }
    }

    function showFallback(msg: string) {
      const ctx = canvas!.getContext('2d')
      if (ctx) {
        ctx.fillStyle = '#0d1117'
        ctx.fillRect(0, 0, canvas!.width, canvas!.height)
        ctx.fillStyle = '#8b949e'
        ctx.font = '13px monospace'
        ctx.textAlign = 'center'
        ctx.fillText('⚠️ ' + msg, canvas!.width / 2, canvas!.height / 2)
      }
      if (gpuBadge) {
        gpuBadge.textContent = 'WebGPU ❌'
        gpuBadge.style.color = 'var(--danger)'
      }
    }

    async function compileAndRender() {
      if (!(await initGPU())) return
      if (!device) return

      const wgsl = editor ? editor.value : defaultShader
      if (errorEl) errorEl.style.display = 'none'

      const hasVertex = /@vertex/.test(wgsl)
      const fullWGSL = hasVertex ? wgsl : FULLSCREEN_QUAD_VERTEX + '\n' + wgsl

      let shaderModule: any
      try {
        shaderModule = device.createShaderModule({ code: fullWGSL })
        const info = await shaderModule.getCompilationInfo()
        const errors = info.messages.filter((m: any) => m.type === 'error')
        const warnings = info.messages.filter((m: any) => m.type !== 'error')
        if (errors.length) {
          showError(
            errors.map((m: any) => `[error] line ${m.lineNum}:${m.linePos} — ${m.message}`).join('\n')
          )
          return
        }
        if (warnings.length) {
          showError(
            warnings.map((m: any) => `[${m.type}] line ${m.lineNum}:${m.linePos} — ${m.message}`).join('\n'),
            'var(--warning)'
          )
        }
      } catch (err: any) {
        showError('❌ 编译错误:\n' + (err?.message || err))
        return
      }

      try {
        const format = (navigator as any).gpu.getPreferredCanvasFormat()
        const pipeline = device.createRenderPipeline({
          layout: 'auto',
          vertex: { module: shaderModule, entryPoint: 'vs_main' },
          fragment: {
            module: shaderModule,
            entryPoint: hasVertex ? 'fs_main' : 'main',
            targets: [{ format }],
          },
          primitive: { topology: 'triangle-list' },
        })

        const context = canvas!.getContext('webgpu')
        if (!context) {
          showFallback('无法获取 WebGPU context')
          return
        }
        context.configure({ device, format, alphaMode: 'premultiplied' })

        const encoder = device.createCommandEncoder()
        const pass = encoder.beginRenderPass({
          colorAttachments: [
            {
              view: context.getCurrentTexture().createView(),
              clearValue: { r: 0, g: 0, b: 0, a: 1 },
              loadOp: 'clear',
              storeOp: 'store',
            },
          ],
        })
        pass.setPipeline(pipeline)
        pass.draw(3)
        pass.end()
        device.queue.submit([encoder.finish()])
      } catch (err: any) {
        showError('❌ 渲染失败:\n' + (err?.message || err))
      }
    }

    if (runBtn) {
      runBtn.addEventListener('click', () => {
        runBtn.textContent = '⏳ 编译中...'
        runBtn.disabled = true
        compileAndRender().finally(() => {
          runBtn.textContent = '▶ 运行'
          runBtn.disabled = false
        })
      })
    }

    // Ctrl+Enter / Cmd+Enter runs the shader (matches the article's hint)
    editor?.addEventListener('keydown', e => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault()
        runBtn?.click()
      }
    })

    const observer = new IntersectionObserver(
      entries => {
        if (entries[0].isIntersecting && !active) {
          active = true
          compileAndRender()
          observer.disconnect()
        }
      },
      { rootMargin: '200px' }
    )
    observer.observe(canvas)
  })
</script>
