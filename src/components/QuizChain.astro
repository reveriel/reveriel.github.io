---
// QuizChain.astro — progressive question sequence.
// Readers answer correctly (with hints) to unlock the next question.
//
// IMPORTANT: Astro does not interpolate `{...}` inside <script> blocks or
// string attributes. All wiring goes through data attributes and scoped
// queries, so multiple instances on one page work too.

interface Question {
  text: string
  type?: 'choice' | 'text'
  options?: string[]
  answer: number | string
  hint?: string
}

interface Props {
  questions?: Question[]
  checkpoint?: boolean
}

const { questions = [], checkpoint = true } = Astro.props
const quizKey = questions.map(q => q.text).join('|').slice(0, 120) || 'default'
---

<div
  class="interactive-block"
  data-quiz
  data-key={quizKey}
  data-checkpoint={checkpoint ? 'true' : 'false'}
  data-questions={JSON.stringify(questions)}
>
  <div class="interactive-block__header">
    <span>🎯 知识挑战 ({questions.length} 题)</span>
    <span data-role="progress" style="font-size: 0.75rem;">0 / {questions.length}</span>
    <a class="component-source" href="https://github.com/reveriel/reveriel.github.io/blob/master/src/components/QuizChain.astro" target="_blank" rel="noopener" title="查看 QuizChain 组件源码">源码 ↗</a>
  </div>
  <div class="interactive-block__body" data-role="body">
    <p style="color: var(--text-muted);">加载挑战中...</p>
  </div>
</div>

<script>
  document.querySelectorAll('[data-quiz]').forEach(root => {
    const body = root.querySelector('[data-role="body"]') as HTMLElement | null
    const progress = root.querySelector('[data-role="progress"]') as HTMLElement | null
    if (!body || !progress) return

    let qs: any[] = []
    try {
      qs = JSON.parse(root.getAttribute('data-questions') || '[]')
    } catch {
      qs = []
    }

    if (!qs.length) {
      body.innerHTML = '<p style="color: var(--text-muted);">暂无挑战。</p>'
      return
    }

    const useCheckpoint = root.getAttribute('data-checkpoint') === 'true'
    const storageKey = 'quiz:' + (root.getAttribute('data-key') || '')
    let currentIndex = 0
    let passed = 0

    if (useCheckpoint) {
      try {
        const saved = localStorage.getItem(storageKey)
        if (saved) {
          const { idx, p } = JSON.parse(saved)
          currentIndex = Math.min(idx, qs.length)
          passed = Math.min(p, qs.length)
        }
      } catch {}
    }

    function save() {
      if (useCheckpoint) {
        try {
          localStorage.setItem(storageKey, JSON.stringify({ idx: currentIndex, p: passed }))
        } catch {}
      }
    }

    const esc = (s: any) =>
      String(s).replace(
        /[&<>"']/g,
        c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string)
      )

    function checkAnswer(given: string | number) {
      const q = qs[currentIndex]
      const correct = q.answer

      const isCorrect =
        typeof correct === 'number' && typeof given === 'number'
          ? given === correct
          : String(given).trim().toLowerCase() === String(correct).trim().toLowerCase()

      const step = body.querySelector('.quiz-step') as HTMLElement | null
      const feedback = step?.querySelector('[data-role="feedback"]') as HTMLElement | null
      if (!step || !feedback) return

      if (isCorrect) {
        step.classList.remove('active')
        step.classList.add('passed')
        feedback.textContent = '✅ 正确！'
        feedback.style.color = 'var(--success)'
        passed++
        save()
        setTimeout(() => {
          currentIndex++
          render()
        }, 800)
      } else {
        step.classList.add('failed')
        feedback.textContent = q.type === 'text' ? '❌ 不对，再试试。' : '❌ 不对，再选一次。'
        feedback.style.color = 'var(--danger)'
        setTimeout(() => step.classList.remove('failed'), 600)
      }
    }

    function render() {
      progress.textContent = `${passed} / ${qs.length}`

      if (currentIndex >= qs.length) {
        body.innerHTML = `
          <div style="text-align: center; padding: 2rem;">
            <p style="font-size: 1.2rem; color: var(--success);">
              ✅ 全部完成！通过了 ${passed}/${qs.length} 道挑战。
            </p>
            ${
              passed === qs.length
                ? '<p style="color: var(--accent);">太棒了，你掌握了本章的所有概念。</p>'
                : '<p style="color: var(--text-muted);">重新试试，你可以做得更好。</p>'
            }
          </div>`
        return
      }

      const q = qs[currentIndex]
      const isText = q.type === 'text'
      const options = (q.options || []) as string[]

      body.innerHTML = `
        <div class="quiz-step active">
          <p style="font-weight: 600; margin-bottom: 0.6rem;">
            第 ${currentIndex + 1} 题：${esc(q.text)}
          </p>
          ${
            isText
              ? `<input
                  type="text"
                  data-role="input"
                  placeholder="输入你的答案，按回车提交..."
                  style="
                    width: 100%; font-family: var(--font-mono); font-size: 0.9rem;
                    background: var(--bg); color: var(--text);
                    border: 1px solid var(--border); border-radius: 4px;
                    padding: 0.5em 0.7em; outline: none;
                  "
                />`
              : `<div style="display: flex; flex-direction: column; gap: 0.4rem;">
                  ${options
                    .map(
                      (opt, i) => `
                    <button
                      data-idx="${i}"
                      style="
                        text-align: left; padding: 0.5em 0.8em;
                        font-size: 0.9rem;
                        background: var(--bg); color: var(--text);
                        border: 1px solid var(--border); border-radius: 4px;
                        cursor: pointer;
                      "
                      onmouseover="this.style.borderColor='var(--accent)'"
                      onmouseout="this.style.borderColor='var(--border)'"
                    >${esc(opt)}</button>`
                    )
                    .join('')}
                </div>`
          }
          <div
            data-role="feedback"
            style="margin-top: 0.5rem; font-size: 0.82rem; min-height: 1.5em;"
          ></div>
          ${
            q.hint
              ? `<button
                  data-role="hint"
                  style="
                    font-size: 0.75rem; background: none; color: var(--warning);
                    border: none; cursor: pointer; padding: 0.2em 0;
                  "
                >💡 显示提示</button>`
              : ''
          }
        </div>`

      if (isText) {
        const input = body.querySelector('[data-role="input"]') as HTMLInputElement | null
        input?.addEventListener('keydown', e => {
          if (e.key === 'Enter') checkAnswer((e.target as HTMLInputElement).value)
        })
        input?.focus()
      } else {
        body.querySelectorAll('button[data-idx]').forEach(btn => {
          btn.addEventListener('click', () => checkAnswer(parseInt(btn.getAttribute('data-idx')!, 10)))
        })
      }

      const hintBtn = body.querySelector('[data-role="hint"]') as HTMLButtonElement | null
      hintBtn?.addEventListener('click', () => {
        const fb = body.querySelector('[data-role="feedback"]') as HTMLElement | null
        if (fb) {
          fb.textContent = `💡 ${q.hint}`
          fb.style.color = 'var(--warning)'
        }
      })
    }

    render()
  })
</script>
