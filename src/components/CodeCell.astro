---
// CodeCell.astro — runnable code cell with JS or Python (Pyodide).
// Uses a plain <textarea> for reliable editing (no HTML injection).
//
// IMPORTANT: Astro does not interpolate `{...}` inside <script> blocks or
// string attributes, so everything is wired through data attributes.

interface Props {
  lang?: 'js' | 'python'
  caption?: string
  code?: string
}

const { lang = 'js', caption, code } = Astro.props
const langLabel = lang === 'python' ? '🐍 Python (Pyodide)' : '🟨 JavaScript'
---

<div class="interactive-block" data-code-cell data-lang={lang}>
  <div class="interactive-block__header">
    <span>{langLabel}{caption ? ` — ${caption}` : ''}</span>
    <button data-role="run" style="
      font-size: 0.75rem; background: var(--accent-dim); color: #fff;
      border: none; border-radius: 4px; padding: 0.25em 0.8em; cursor: pointer;
    ">▶ 运行</button>
  </div>
  <div class="interactive-block__body">
    <textarea
      data-role="code"
      spellcheck="false"
      style="
        width: 100%; font-family: var(--font-mono); font-size: 0.82rem;
        background: var(--bg); color: var(--text);
        border: 1px solid var(--border); border-radius: var(--radius);
        padding: 0.8rem; min-height: 5rem; resize: vertical;
        line-height: 1.5; tab-size: 2; outline: none;
        white-space: pre; overflow-x: auto;
      "
    >{code || ''}</textarea>
    <pre
      data-role="output"
      style="
        font-family: var(--font-mono); font-size: 0.8rem;
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: 4px; padding: 0.6rem 0.8rem; margin-top: 0.5rem;
        min-height: 1.5rem; color: var(--text-muted); white-space: pre-wrap;
      "
    >点击"运行"以执行代码</pre>
  </div>
</div>

<script>
  let pyodidePromise: Promise<any> | null = null

  function loadPyodideOnce(): Promise<any> {
    if (pyodidePromise) return pyodidePromise
    pyodidePromise = (async () => {
      const w = window as any
      if (typeof w.loadPyodide === 'undefined') {
        const s = document.createElement('script')
        s.src = 'https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js'
        await new Promise<void>((resolve, reject) => {
          s.onload = () => resolve()
          s.onerror = () => reject(new Error('Pyodide 脚本加载失败'))
          document.head.appendChild(s)
        })
      }
      return w.loadPyodide({ indexURL: 'https://cdn.jsdelivr.net/pyodide/v0.25.0/full/' })
    })()
    return pyodidePromise
  }

  document.querySelectorAll('[data-code-cell]').forEach(root => {
    const btn = root.querySelector('[data-role="run"]') as HTMLButtonElement | null
    const codeEl = root.querySelector('[data-role="code"]') as HTMLTextAreaElement | null
    const outputEl = root.querySelector('[data-role="output"]') as HTMLElement | null
    if (!btn || !codeEl || !outputEl) return

    const lang = root.getAttribute('data-lang') || 'js'

    function setOutput(text: string, color = 'var(--text)') {
      outputEl!.textContent = text
      outputEl!.style.color = color
    }

    btn.addEventListener('click', async () => {
      const code = codeEl.value || ''
      btn.disabled = true
      setOutput('运行中...', 'var(--text-muted)')

      try {
        if (lang === 'python') {
          const py = await loadPyodideOnce()
          let output = ''
          py.setStdout({ batched: (s: string) => { output += s + '\n' } })
          py.setStderr({ batched: (s: string) => { output += '[err] ' + s + '\n' } })
          const result = py.runPython(code)
          if (result !== undefined && result !== null) output += String(result) + '\n'
          setOutput(output || '(无输出)', 'var(--success)')
          result?.destroy?.()
        } else {
          const logs: string[] = []
          const origLog = console.log
          const origErr = console.error
          const fmt = (a: any) => (typeof a === 'object' ? JSON.stringify(a, null, 2) : String(a))
          console.log = (...args: any[]) => { logs.push(args.map(fmt).join(' ')); origLog(...args) }
          console.error = (...args: any[]) => { logs.push('[err] ' + args.map(fmt).join(' ')); origErr(...args) }
          try {
            const result = (0, eval)(code)
            if (result !== undefined) logs.push(String(result))
          } finally {
            console.log = origLog
            console.error = origErr
          }
          setOutput(logs.join('\n') || '(无输出)', 'var(--success)')
        }
      } catch (err: any) {
        setOutput('❌ ' + (err?.message || err), 'var(--danger)')
      } finally {
        btn.disabled = false
      }
    })
  })
</script>
