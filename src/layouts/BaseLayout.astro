---
// BaseLayout.astro — every page wraps in this.
import { t } from '@i18n/ui'
import '@styles/global.css'

interface Props {
  title: string
  description?: string
  ogImage?: string
  ogType?: string
}

const SITE = 'Reveriel'
const TAGLINE = 'Interactive Knowledge'
const BASE_URL = 'https://www.reveriel.com'

// Determine locale from URL path: /en/... → en, everything else → zh-CN
const locale = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en' ? 'en' : 'zh-CN'
const strings = t(locale)
const { title, description, ogImage, ogType = 'website' } = Astro.props
const desc = description || strings.site.description
const image = ogImage || `${BASE_URL}/og-default.png`

// Build language switcher URLs
const currentPath = Astro.url.pathname
const otherLocale = locale === 'zh-CN' ? 'en' : 'zh-CN'
const otherPath = locale === 'zh-CN'
  ? `/en${currentPath}`
  : currentPath.replace(/^\/en(?=\/|$)/, '') || '/'
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="_iLFDDaKcbQjCO-srdRiCsmMe93QLnbO1kacTQygY7Q" />
    <meta name="description" content={desc} />

    <!-- Open Graph -->
    <meta property="og:title" content={title === SITE ? `${SITE} · ${TAGLINE}` : `${title} — ${SITE}`} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content={`${SITE} · ${TAGLINE}`} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title === SITE ? `${SITE} · ${TAGLINE}` : `${title} — ${SITE}`} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={image} />

    <title>{title === SITE ? `${SITE} · ${TAGLINE}` : `${title} — ${SITE}`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <nav class="container" style="
      display: flex; gap: 1.5rem; padding-top: 1.5rem; padding-bottom: 1rem;
      font-size: 0.9rem; border-bottom: 1px solid var(--border);
    ">
      <a href={locale === 'en' ? '/en' : '/'} style="font-weight:700; color: var(--text);">{SITE}</a>
      <a href={locale === 'en' ? '/en/posts' : '/posts'}>{strings.nav.posts}</a>
      <a href={locale === 'en' ? '/en/graph' : '/graph'}>{strings.nav.graph}</a>
      <span style="flex:1"></span>
      <a
        href={otherPath}
        style="font-size: 0.82rem; color: var(--text-muted);"
        title={strings.lang.label}
      >{otherLocale === 'en' ? 'EN' : '中文'}</a>
    </nav>

    <main class="container">
      <slot />
    </main>

    <footer style="
      text-align: center; padding: 3rem 1rem;
      font-size: 0.8rem; color: var(--text-muted);
    ">
      <p>{SITE} · {TAGLINE}</p>
      <p style="margin-top: 0.3rem;">{strings.footer.motto}</p>
    </footer>
  </body>
</html>
