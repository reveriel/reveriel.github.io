---
// PostLayout.astro — wraps every blog article.
import { getCollection, type CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import GiscusComments from '@components/GiscusComments.astro'
import { t } from '@i18n/ui'

interface Props { post: CollectionEntry<'posts'> }

const { post } = Astro.props
const { title, date, stage, series, seriesOrder, prerequisites, concepts, tags, summary, locale: postLocale } = post.data

const locale = Astro.url.pathname.startsWith('/en/') ? 'en' : 'zh-CN'
const strings = t(locale)

const BASE_URL = 'https://www.reveriel.com'
const slug = post.id
  .replace(/\/index\.(mdx|md)$/, '')
  .replace(/\.(mdx|md)$/, '')
  .replace(/\/(en|zh-CN)$/, '')
const allPosts = await getCollection('posts')
const hasZh = allPosts.some((p) => {
  const s = p.id.replace(/\/index\.(mdx|md)$/, '').replace(/\.(mdx|md)$/, '').replace(/\/(en|zh-CN)$/, '')
  return s === slug && (p.data.locale || 'zh-CN') === 'zh-CN'
})
const hasEn = allPosts.some((p) => {
  const s = p.id.replace(/\/index\.(mdx|md)$/, '').replace(/\.(mdx|md)$/, '').replace(/\/(en|zh-CN)$/, '')
  return s === slug && (p.data.locale || 'zh-CN') === 'en'
})

function formatDate(d: Date) {
  const l = locale === 'en' ? 'en-US' : 'zh-CN'
  return d.toLocaleDateString(l, { year: 'numeric', month: 'long', day: 'numeric' })
}
---

<BaseLayout title={title} description={summary} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    {tags.map(t => <meta property="article:tag" content={t} />)}
    {hasZh && <link rel="alternate" hreflang="zh-CN" href={`${BASE_URL}/posts/${slug}/`} />}
    {hasEn && <link rel="alternate" hreflang="en" href={`${BASE_URL}/en/posts/${slug}/`} />}
    {hasZh && <link rel="alternate" hreflang="x-default" href={`${BASE_URL}/posts/${slug}/`} />}
  </Fragment>

  <article>
    <header style="margin-bottom: 2rem;">
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.6rem;">
        <span class={`stage-badge stage-${stage}`}>
          {stage === 1 && '🌱 '}
          {stage === 2 && '🌿 '}
          {stage === 3 && '🌳 '}
          {stage === 4 && '⚡ '}
          {stage === 5 && '🔥 '}
          Stage {stage}
        </span>
        {series && (
          <span style="font-size: 0.78rem; color: var(--accent); background: var(--bg-card); padding: 0.15em 0.6em; border-radius: 10px; border: 1px solid var(--border);">
            📚 {series}{seriesOrder != null ? ` #${seriesOrder}` : ''}
          </span>
        )}
        {tags.map(t => <span class="concept-tag">{t}</span>)}
      </div>

      <h1 style="margin-top: 0.3rem;">{title}</h1>
      <time datetime={date.toISOString()} style="color: var(--text-muted); font-size: 0.85rem;">
        {formatDate(date)}
      </time>

      {
        prerequisites.length > 0 && (
          <div style="margin-top: 1rem; font-size: 0.85rem;">
            <span style="color: var(--text-muted);">{strings.post.prerequisite}：</span>
            {prerequisites.map(p => <span class="concept-tag">{p}</span>)}
          </div>
        )
      }

      {
        concepts.length > 0 && (
          <div style="margin-top: 0.5rem; font-size: 0.85rem;">
            <span style="color: var(--text-muted);">{strings.post.concepts}：</span>
            {concepts.map(c => <span class="concept-tag unlocked">{c}</span>)}
          </div>
        )
      }
    </header>

    <div class="post-body">
      <slot />
    </div>

    <GiscusComments />
  </article>
</BaseLayout>
