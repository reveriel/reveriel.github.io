---
// /graph — knowledge graph with series filtering, locale-aware.
import { buildGraph } from '@lib/knowledge-graph'
import BaseLayout from '@layouts/BaseLayout.astro'
import { t } from '@i18n/ui'

const locale = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh-CN'
const strings = t(locale)

const graph = await buildGraph(locale)
const { posts, stages, series } = graph

const sortedStages = [...stages.entries()].sort(([a], [b]) => a - b)
const seriesNames = [...series.keys()].sort()
---

<BaseLayout title={strings.graph.heading}>
  <h1>{strings.graph.heading}</h1>
  <p style="color: var(--text-muted); margin-bottom: 1rem;">
    {strings.graph.description}
  </p>

  <!-- Series filter -->
  {seriesNames.length > 0 && (
    <nav style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.5rem;">
      <a href="?view=stage" style="
        padding: 0.3em 0.8em; font-size: 0.82rem;
        background: var(--bg-elevated); border: 1px solid var(--border);
        border-radius: 14px; color: var(--text); text-decoration: none;
      ">{strings.graph.stageView}</a>
      {seriesNames.map(s => (
        <a href={`?series=${s}`} style="
          padding: 0.3em 0.8em; font-size: 0.82rem;
          background: var(--bg-elevated); border: 1px solid var(--border);
          border-radius: 14px; color: var(--accent); text-decoration: none;
        ">📚 {s}</a>
      ))}
    </nav>
  )}

  <!-- Default: Stage view -->
  <div id="stage-view">
    {sortedStages.map(([stage, stagePosts]) => (
      <section style="margin-bottom: 2rem;">
        <h2 style="display: flex; align-items: center; gap: 0.5rem;">
          <span class={`stage-badge stage-${stage}`}>Stage {stage}</span>
        </h2>

        {stagePosts.map(p => (
          <div style="
            margin: 0.8rem 0; padding: 0.8rem 1rem;
            background: var(--bg-elevated);
            border: 1px solid var(--border);
            border-radius: var(--radius);
          ">
            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
              <a href={p.url} style="font-weight: 600;">{p.title}</a>
              {p.series && (
                <span style="font-size: 0.72rem; color: var(--accent); background: var(--bg-card); padding: 0.1em 0.5em; border-radius: 8px;">
                  {p.series}{p.seriesOrder != null ? ` #${p.seriesOrder}` : ''}
                </span>
              )}
            </div>

            <div style="margin-top: 0.3rem; font-size: 0.8rem;">
              {p.prerequisites.length > 0 && (
                <span style="color: var(--text-muted);">
                  {strings.graph.prerequisite}：{p.prerequisites.map(c => <span class="concept-tag">{c}</span>)}
                </span>
              )}
              {p.concepts.length > 0 && (
                <span>
                  → {p.concepts.map(c => <span class="concept-tag unlocked">{c}</span>)}
                </span>
              )}
            </div>
          </div>
        ))}
      </section>
    ))}
  </div>

  <!-- Series views (hidden by default, shown by JS) -->
  {seriesNames.map(s => (
    <div id={`series-${s}`} style="display: none;">
      <h2>📚 {s}</h2>
      <p style="color: var(--text-muted); margin-bottom: 1rem;">
        {strings.graph.seriesReadOrder}
      </p>
      {(series.get(s) || []).map((p, i) => (
        <div style="
          display: flex; align-items: flex-start; gap: 0.8rem; margin: 0.6rem 0;
          padding: 0.8rem 1rem;
          background: var(--bg-elevated);
          border: 1px solid var(--border);
          border-radius: var(--radius);
        ">
          <span style="
            font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent);
            min-width: 1.5em; padding-top: 0.1em;
          ">{p.seriesOrder ?? i + 1}.</span>
          <div>
            <a href={p.url} style="font-weight: 600;">{p.title}</a>
            <span class={`stage-badge stage-${p.stage}`} style="margin-left: 0.5rem;">Stage {p.stage}</span>
            <div style="margin-top: 0.2rem; font-size: 0.78rem;">
              {p.concepts.map(c => <span class="concept-tag unlocked">{c}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  ))}

  {posts.length === 0 && (
    <p style="color: var(--text-muted); text-align: center; padding: 3rem;">
      {strings.graph.empty}
    </p>
  )}
</BaseLayout>

<script>
  // Simple client-side series filter
  const params = new URLSearchParams(location.search)
  const series = params.get('series')
  const view = params.get('view')

  if (series) {
    const el = document.getElementById(`series-${series}`)
    const stageView = document.getElementById('stage-view')
    if (el) el.style.display = 'block'
    if (stageView) stageView.style.display = 'none'
  }
  // Default: show stage view (already visible)
</script>
